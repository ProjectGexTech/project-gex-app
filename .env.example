# Copy to .env.local and fill in. These stay on the server: never prefix them with NEXT_PUBLIC_.

# The Odds API (https://the-odds-api.com): live odds
ODDS_API_KEY=

# API-Football (https://www.api-football.com): fallback team stats and head-to-head.
# Optional: the ML server's match history covers 13 leagues without it.
API_FOOTBALL_KEY=

# Python ML server (python_model/app.py). Defaults to http://localhost:8000
# ML_SERVER_URL=http://localhost:8000
